# llm7 (сейчас):
LLM_BASE_URL=https://api.llm7.io/v1
LLM_API_KEY=your_llm7_key_here
LLM_MODEL=DeepSeek-V4-Flash-0731
# Запасная модель, если основная перегружена (можно оставить пустым):
# LLM_FALLBACK=gemini-3-flash

# Старые имена для совместимости (если LLM_* не заданы):
# MISTRAL_API_KEY=your_mistral_key_here
# MODEL=mistral-small-latest
