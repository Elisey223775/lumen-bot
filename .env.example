TELEGRAM_BOT_TOKEN=your_telegram_token_here

# --- Провайдер LLM (универсально через OpenAI-совместимый API) ---
# Mistral (было):
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your_mistral_key_here
